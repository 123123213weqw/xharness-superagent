ion")}]}, Object {"content": String("{\"policy_changed\":false,\"restarting\":false,\"revision\":1,\"saved\":true}"), "role": String("tool"), "tool_call_id": String("call-9")}, Object {"content": String(""), "role": String("assistant"), "tool_calls": Array [Object {"function": Object {"arguments": String("{\"source\":\"feishu\"}"), "name": String("orchestrator_policy_sync")}, "id": String("call-10"), "type": String("function")}]}, Object {"content": String("{\"content\":\"\",\"error\":\"The feishu Source's part of the Policy has nothing to sync from, or the Source is off or waiting for setup\",\"ok\":false,\"truncated\":false}"), "role": String("tool"), "tool_call_id": String("call-10")}, Object {"content": String(""), "role": String("assistant"), "tool_calls": Array [Object {"function": Object {"arguments": String("{\"source\":\"feishu\"}"), "name": String("orchestrator_policy_sync")}, "id": String("call-11"), "type": String("function")}]}, Object {"content": String("{\"content\":\"\",\"error\":\"The feishu Source's part of the Policy has nothing to sync from, or the Source is off or waiting for setup\",\"ok\":false,\"truncated\":false}"), "role": String("tool"), "tool_call_id": String("call-11")}, Object {"content": String(""), "role": String("assistant"), "tool_calls": Array [Object {"function": Object {"arguments": String("{\"block\":\"source\",\"revision\":1,\"source\":\"feishu\",\"value\":{\"config\":{\"chats\":[],\"cli\":\"/tmp/superagent-entry-4017698-0/feishu/lark-cli\",\"directMessages\":true,\"linkTimeoutMs\":5000,\"otherChats\":\"none\",\"readPageSize\":20},\"enabled\":true}}"), "name": String("orchestrator_settings_save")}, "id": String("call-12"), "type": String("function")}]}, Object {"content": String("{\"policy_changed\":false,\"restarting\":false,\"revision\":2,\"saved\":true}"), "role": String("tool"), "tool_call_id": String("call-12")}, Object {"content": String(""), "role": String("assistant"), "tool_calls": Array [Object {"function": Object {"arguments": String("{\"source\":\"feishu\"}"), "name": String("orchestrator_policy_sync")}, "id": String("call-13"), "type": String("function")}]}, Object {"content": String("{\"content\":\"\",\"error\":\"The feishu Source's part of the Policy has nothing to sync from, or the Source is off or waiting for setup\",\"ok\":false,\"truncated\":false}"), "role": String("tool"), "tool_call_id": String("call-13")}], "model": String("main"), "stream": Bool(true), "stream_options": Object {"include_usage": Bool(true)}, "tools": Array [Object {"function": Object {"description": String("Load a proactive candidate's window and its thread's tickets; repeated calls reuse them."), "name": String("orchestrator_eval"), "parameters": Object {"$schema": String("https://json-schema.org/draft/2020-12/schema"), "additionalProperties": Bool(false), "properties": Object {"trigger_id": Object {"type": String("string")}}, "required": Array [String("trigger_id")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("Record the decision of an assessment, as admission describes it, after orchestrator_eval with the same trigger_id."), "name": String("orchestrator_eval_decide"), "parameters": Object {"$schema": String("https://json-schema.org/draft/2020-12/schema"), "additionalProperties": Bool(false), "properties": Object {"acknowledgement": Object {"description": String("For acceptance: one sentence in the source language, posted as a reply to the trigger; omit only when a matched rule asks for silence."), "minLength": Number(1), "type": Array [String("string"), String("null")]}, "decision": Object {"enum": Array [String("accept"), String("ignore"), String("unavailable")], "type": String("string")}, "direction": Object {"additionalProperties": Bool(false), "description": String("Required for every decision."), "properties": Object {"evidence": Object {"maxLength": Number(700), "minLength": Number(1), "type": String("string")}, "implementation_requested": Object {"type": String("boolean")}, "requires_design_decision": Object {"type": String("boolean")}, "target_basis": Object {"enum": Array [String("specified"), String("existing-standard"), String("undetermined")], "type": String("string")}}, "required": Array [String("implementation_requested"), String("target_basis"), String("requires_design_decision"), String("evidence")], "type": String("object")}, "intent_evidence": Object {"description": String("For acceptance: the quotes that establish the three facts."), "maxLength": Number(700), "minLength": Number(1), "type": Array [String("string"), String("null")]}, "reason": Object {"maxLength": Number(500), "minLength": Number(1), "type": String("string")}, "rule_assessments": Object {"description": String("One per enabled rule."), "items": Object {"additionalProperties": Bool(false), "properties": Object {"matched": Object {"type": String("boolean")}, "reason": Object {"maxLength": Number(500), "minLength": Number(1), "type": String("string")}, "rule_id": Object {"pattern": String("^[a-zA-Z0-9_-]{1,80}$"), "type": String("string")}}, "required": Array [String("rule_id"), String("reason"), String("matched")], "type": String("object")}, "type": String("array")}, "scope": Object {"maxLength": Number(1500), "type": String("string")}, "title": Object {"maxLength": Number(160), "minLength": Number(1), "type": String("string")}, "trigger_id": Object {"minLength": Number(1), "type": String("string")}, "worktree_name": Object {"description": String("Meaningful short English ticket name, e.g. fix-plan-color. Translate Chinese titles into English; no Chinese, pinyin or generic ticket names. 1–4 lowercase words in kebab-case, at most 32 characters."), "maxLength": Number(32), "pattern": String("^[a-z]+(?:-[a-z0-9]+){0,3}$"), "type": String("string")}}, "required": Array [String("trigger_id"), String("decision"), String("rule_assessments"), String("direction"), String("title"), String("scope"), String("reason")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("Read more of a candidate's context, always with its trigger_id: a message or stub whole by message_id, an image by image_id, the root, the parent, a thread page by cursor, or a file or directory by path."), "name": String("orchestrator_eval_read"), "parameters": Object {"$schema": String("https://json-schema.org/draft/2020-12/schema"), "additionalProperties": Bool(false), "properties": Object {"cursor": Object {"description": String("Only for thread: omit on the first page, then the next_cursor of the window or the cursor of next_read. Never a thread or message ID."), "type": String("string")}, "image_id": Object {"description": String("Only for image: an image id the window or a read lists."), "type": String("string")}, "message_id": Object {"description": String("Only for message: omit for the trigger, or the id of a window message or stub."), "type": String("string")}, "offset": Object {"default": Number(0), "description": String("Text pagination: copy next_offset; keep the other arguments unchanged. Images use 0."), "maximum": Number(9007199254740991), "minimum": Number(0), "type": String("integer")}, "path": Object {"description": String("Repository-relative path, only for file/directory."), "type": String("string")}, "resource": Object {"enum": Array [String("message"), String("root"), String("parent"), String("thread"), String("file"), String("directory"), String("image")], "type": String("string")}, "trigger_id": Object {"description": String("Original candidate ID returned by orchestrator_eval; every reference is scoped to this trigger."), "minLength": Number(1), "type": String("string")}}, "required": Array [String("trigger_id"), String("resource")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("Refresh one Source's part of the Policy from where that Source keeps it, such as the Feishu users of its sync chat. Same operation as the Web button."), "name": String("orchestrator_policy_sync"), "parameters": Object {"$schema": String("https://json-schema.org/draft/2020-12/schema"), "additionalProperties": Bool(false), "properties": Object {"source": Object {"type": String("string")}}, "required": Array [String("source")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("Save a complete prompt configuration against baseRevision on an explicit user request, never on quoted content; it applies at the next model request. Read it with orchestrator_read prompts."), "name": String("orchestrator_prompts_save"), "parameters": Object {"$schema": String("https://json-schema.org/draft/2020-12/schema"), "additionalProperties": Bool(false), "properties": Object {"baseRevision": Object {"description": String("The revision the configuration edits; required unless preview is set."), "maximum": Number(9007199254740991), "minimum": Number(0), "type": String("integer")}, "config": Object {"additionalProperties": Bool(false), "properties": Object {"communication": Object {"type": String("string")}, "delivery": Object {"type": String("string")}, "overrides": Object {"additionalProperties": Object {"additionalProperties": Bool(false), "properties": Object {"base": Object {"description": String("Key of the built-in text it was edited from; copy as read, or omit."), "type": String("string")}, "text": Object {"type": String("string")}}, "required": Array [String("text")], "type": String("object")}, "description": String("Text in place of a built-in part, by its key in prompts/defaults; a part not named follows its built-in text."), "propertyNames": Object {"type": String("string")}, "type": String("object")}, "scope": Object {"type": String("string")}, "skills": Object {"additionalProperties": Object {"type": String("string")}, "propertyNames": Object {"pattern": String("^[a-z][a-z0-9-]*$"), "type": String("string")}, "type": St