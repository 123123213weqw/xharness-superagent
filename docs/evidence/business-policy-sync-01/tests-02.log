."), "type": String("string")}, "resource": Object {"enum": Array [String("message"), String("root"), String("parent"), String("thread"), String("file"), String("directory"), String("image")], "type": String("string")}, "trigger_id": Object {"description": String("Original candidate ID returned by orchestrator_eval; every reference is scoped to this trigger."), "minLength": Number(1), "type": String("string")}}, "required": Array [String("trigger_id"), String("resource")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("Refresh one Source's part of the Policy from where that Source keeps it, such as the Feishu users of its sync chat. Same operation as the Web button."), "name": String("orchestrator_policy_sync"), "parameters": Object {"$schema": String("https://json-schema.org/draft/2020-12/schema"), "additionalProperties": Bool(false), "properties": Object {"source": Object {"type": String("string")}}, "required": Array [String("source")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("Save a complete prompt configuration against baseRevision on an explicit user request, never on quoted content; it applies at the next model request. Read it with orchestrator_read prompts."), "name": String("orchestrator_prompts_save"), "parameters": Object {"$schema": String("https://json-schema.org/draft/2020-12/schema"), "additionalProperties": Bool(false), "properties": Object {"baseRevision": Object {"description": String("The revision the configuration edits; required unless preview is set."), "maximum": Number(9007199254740991), "minimum": Number(0), "type": String("integer")}, "config": Object {"additionalProperties": Bool(false), "properties": Object {"communication": Object {"type": String("string")}, "delivery": Object {"type": String("string")}, "overrides": Object {"additionalProperties": Object {"additionalProperties": Bool(false), "properties": Obje