": Number(1), "type": String("string")}, "implementation_requested": Object {"type": String("boolean")}, "requires_design_decision": Object {"type": String("boolean")}, "target_basis": Object {"enum": Array [String("specified"), String("existing-standard"), String("undetermined")], "type": String("string")}}, "required": Array [String("implementation_requested"), String("target_basis"), String("requires_design_decision"), String("evidence")], "type": String("object")}, "intent_evidence": Object {"description": String("For acceptance: the quotes that establish the three facts."), "maxLength": Number(700), "minLength": Number(1), "type": Array [String("string"), String("null")]}, "reason": Object {"maxLength": Number(500), "minLength": Number(1), "type": String("string")}, "rule_assessments": Object {"description": String("One per enabled rule."), "items": Object {"additionalProperties": Bool(false), "properties": Object {"matched": Object {"type": String("boolean")}, "reason": Object {"maxLength": Number(500), "minLength": Number(1), "type": String("string")}, "rule_id": Object {"pattern": String("^[a-zA-Z0-9_-]{1,80}$"), "type": String("string")}}, "required": Array [String("rule_id"), String("reason"), String("matched")], "type": String("object")}, "type": String("array")}, "scope": Object {"maxLength": Number(1500), "type": String("string")}, "title": Object {"maxLength": Number(160), "minLength": Number(1), "type": String("string")}, "trigger_id": Object {"minLength": Number(1), "type": String("string")}, "worktree_name": Object {"description": String("Meaningful short English ticket name, e.g. fix-plan-color. Translate Chinese titles into English; no Chinese, pinyin or generic ticket names. 1–4 lowercase words in kebab-case, at most 32 characters."), "maxLength": Number(32), "pattern": String("^[a-z]+(?:-[a-z0-9]+){0,3}$"), "type": String("string")}}, "required": Array [String("trigger_id"), String("decision"), String("rule_assessments"), String("direction"), St