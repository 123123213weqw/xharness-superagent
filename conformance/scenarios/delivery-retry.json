{
  "schema_version": 1,
  "id": "delivery-retry",
  "commands": [
    {
      "op": "receive",
      "trigger": {
        "id": "t1"
      }
    },
    {
      "op": "evaluate_due"
    },
    {
      "op": "decide",
      "trigger": "t1",
      "outcome": {
        "kind": "accept",
        "title": "Fix typo",
        "scope": "Correct only one typo",
        "reason": "Explicit correction request",
        "acknowledgement": "I will correct the typo."
      },
      "as": "one"
    },
    {
      "op": "settle"
    },
    {
      "op": "delivery_failed",
      "ticket": "$one",
      "error": "temporary"
    },
    {
      "op": "advance",
      "milliseconds": 1000
    },
    {
      "op": "retry",
      "ticket": "$one"
    },
    {
      "op": "settle"
    }
  ],
  "expected_summary": {
    "tickets": 1,
    "ended": 0
  }
}
