[Unit]
Description=XHarness SuperAgent (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/xharness-superagent/%i
ExecStart=%h/.local/lib/xharness-superagent/%i/bin/xharness-superagent --config %h/.config/xharness-superagent/%i/config.json
EnvironmentFile=-%h/.config/xharness-superagent/shared-search.environment
EnvironmentFile=-%h/.config/xharness-superagent/%i/environment
UMask=0077
NoNewPrivileges=yes
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=45
SendSIGKILL=yes
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=default.target
